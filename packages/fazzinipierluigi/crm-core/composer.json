{
    "name": "fazzinipierluigi/crm-core",
    "description": "Core package (models, migrations, service provider) for the AsgardCRM extensible entity/workflow CRM.",
    "license": "MIT",
    "authors": [
        {
            "name": "Pierluigi Fazzini",
            "email": "fazzinipierluigi@gmail.com"
        }
    ],
    "homepage": "https://github.com/fazzinipierluigi/crm-core",
    "keywords": ["Laravel", "CRM", "crm-core"],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "fazzinipierluigi/just-a-gate": "^1.0",
        "fazzinipierluigi/laraccoon-layouts": "^1.0",
        "fazzinipierluigi/laraccoon_datasource": "^1.0",
        "jwadhams/json-logic-php": "^1.5",
        "symfony/expression-language": "^7.0",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Fazzinipierluigi\\CrmCore\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Fazzinipierluigi\\CrmCore\\Tests\\": "tests/",
            "Fazzinipierluigi\\CrmCore\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fazzinipierluigi\\CrmCore\\CrmServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
